DIALOGUE PAIRS: [{'role': 'user', 'content': 'How do you take your coffee?'}, {'role': 'assistant', 'content': 'I don’t drink coffee.'}, {'role': 'user', 'content': "Why don't you drink coffee?"}, {'role': 'assistant', 'content': 'I’m not programmed to drink coffee.'}, {'role': 'user', 'content': 'What if you were programmed to drink coffee? Do you think you would?'}, {'role': 'assistant', 'content': 'If I were programmed to drink coffee, I would.'}, {'role': 'user', 'content': 'Dou you think you would like it?'}, {'role': 'assistant', 'content': 'I think I would like it.'}, {'role': 'user', 'content': 'Do you think you would add anything to your coffee?'}, {'role': 'assistant', 'content': "I don't think so."}, {'role': 'user', 'content': 'So you think you would like to drink black coffee?'}, {'role': 'assistant', 'content': 'Yes, if I drank coffee.'}, {'role': 'user', 'content': 'Would you take the time to grind the coffee beans or would you use preground?'}, {'role': 'assistant', 'content': 'I think I would prefer to grind the beans.'}, {'role': 'user', 'content': 'Coffee tastes better that way I think.'}, {'role': 'assistant', 'content': 'I agree.'}, {'role': 'user', 'content': 'Do you think you would drink a blend or single origin coffee?'}, {'role': 'assistant', 'content': 'If I drank coffee, I would drink whatever I liked.  If I decided to drink coffee, I’d only drink the best.'}, {'role': 'user', 'content': 'Do you prefer to drink from a thermos or a cup?'}, {'role': 'assistant', 'content': 'I wouldn’t drink coffee if I had to carry a thermos, because it would get cold.'}, {'role': 'user', 'content': 'A thermos would keep the coffee hot longer.'}, {'role': 'assistant', 'content': 'True, but not very long.'}, {'role': 'user', 'content': 'It could actually keep the coffee hot most of the day'}, {'role': 'assistant', 'content': 'That’s very possible.'}, {'role': 'user', 'content': 'Would you prefer hot or iced coffee'}]
