DIALOGUE PAIRS: [{'role': 'user', 'content': 'I want to know which show is the highest-grossing production on Broadway?'}, {'role': 'assistant', 'content': 'The following shows had the highest gross during the 2018–2019 season.'}, {'role': 'user', 'content': 'I want to see The Lion King.  Is it still available?'}, {'role': 'assistant', 'content': 'The musical The Lion King, is still playing at the Lyric Theatre.  Ticket availability is typically limited to 3-4 months in advance, and it is also available for viewing as a filmed performance in theatres around the world.'}, {'role': 'user', 'content': 'How much are the tickets?'}]
