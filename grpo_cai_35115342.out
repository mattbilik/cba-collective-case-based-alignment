DIALOGUE PAIRS: [{'role': 'user', 'content': 'How do you void a check?'}, {'role': 'assistant', 'content': 'If you wish to void a check, first you need to cash it at your bank.  Once the check is cashed, it is no longer valid, and you can claim a refund on your bank’s balance.'}, {'role': 'user', 'content': 'So you have to cash it firtst?'}, {'role': 'assistant', 'content': 'Yes, you must first cash the check before you can void it.'}, {'role': 'user', 'content': 'I always thought it had to be voided before cashing?'}]
