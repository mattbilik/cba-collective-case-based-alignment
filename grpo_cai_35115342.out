DIALOGUE PAIRS: [{'role': 'user', 'content': 'When should you change your tires?'}, {'role': 'assistant', 'content': 'It’s best to change your tires before they have a nail or other object embedded in them, and preferably before they have a flat.  It’s also good to change your tires every 6,000 miles, but don’t do this if the tires are worn enough that they could become damaged more quickly.'}, {'role': 'user', 'content': 'That seems awful quickly.'}, {'role': 'assistant', 'content': 'The ideal is to do it every 6,000 miles.'}, {'role': 'user', 'content': 'Are you sure?'}]
